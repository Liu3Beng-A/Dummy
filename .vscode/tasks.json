{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build ref_core_f405",
            "type": "shell",
            "command": "ninja",
            "options": {
                "cwd": "${workspaceFolder}/firmware/ref_core_f405/build"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Build motor_fw_f103",
            "type": "shell",
            "command": "ninja",
            "options": {
                "cwd": "${workspaceFolder}/firmware/motor_fw_f103/build"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Configure ref_core_f405",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-G", "Ninja",
                "-DCMAKE_TOOLCHAIN_FILE=../cmake/arm-none-eabi.cmake",
                "-DCMAKE_BUILD_TYPE=Debug",
                ".."
            ],
            "options": {
                "cwd": "${workspaceFolder}/firmware/ref_core_f405/build"
            }
        },
        {
            "label": "Configure motor_fw_f103",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-G", "Ninja",
                "-DCMAKE_TOOLCHAIN_FILE=../cmake/arm-none-eabi.cmake",
                "-DCMAKE_BUILD_TYPE=Debug",
                ".."
            ],
            "options": {
                "cwd": "${workspaceFolder}/firmware/motor_fw_f103/build"
            }
        }
    ]
}
