QWidget { font-family: 'Microsoft YaHei UI'; font-size: 14px; color: #d1deec; }
QMainWindow, QWidget#Workspace { background: #142031; }
QMessageBox, QInputDialog { background: #142031; color: #e2edf8; }
QMessageBox QLabel, QInputDialog QLabel { background: transparent; color: #e2edf8; font-size: 15px; padding: 2px 0; }
QMessageBox QDialogButtonBox, QInputDialog QDialogButtonBox { background: transparent; }
QMessageBox QPushButton, QInputDialog QPushButton { color: #d2e4f3; background: #263a51; border: 1px solid #536d88; font-size: 14px; padding: 8px 14px; min-width: 58px; }
QMessageBox QPushButton:hover, QInputDialog QPushButton:hover { background: #304d69; border-color: #6899bd; }
QMessageBox QPushButton:default, QInputDialog QPushButton:default { color: white; background: #297ab6; border-color: #297ab6; font-weight: 600; }
QMessageBox QTextEdit, QInputDialog QTextEdit, QInputDialog QPlainTextEdit { color: #e2edf8; background: #0f1b2c; border: 1px solid #536d88; font-size: 15px; }
QFrame#TopBar { background: #1b2a3e; border-bottom: 1px solid #314359; }
QFrame#TopBar QLabel#StatusPill { padding: 0; }
QFrame#OperationStatusPanel { background: #1b3044; border-bottom: 1px solid #38516a; }
QFrame#OperationStatusPanel[tone='warning'] { background: #393123; border-color: #675338; }
QFrame#OperationStatusPanel[tone='error'] { background: #3b282e; border-color: #72424b; }
QLabel#OperationStatusTitle { color: #b7dcf5; background: transparent; }
QLabel#OperationStatusTitle[tone='success'] { color: #91e3c0; }
QLabel#OperationStatusTitle[tone='warning'] { color: #ffcf84; }
QLabel#OperationStatusTitle[tone='error'] { color: #ffb7b7; }
QLabel#OperationStatusReason, QLabel#OperationStatusNextStep { background: transparent; color: #d3e1ed; font-size: 13px; }
QLabel#OperationStatusElapsed { background: transparent; color: #b0c5d7; font-size: 13px; }
QToolButton#OperationStatusDetailsButton { background: transparent; color: #bad7ed; border: none; padding: 1px 5px; }
QToolButton#OperationStatusDetailsButton:hover { background: #304b62; }
QWidget#OperationStatusConditions, QScrollArea#OperationStatusDetails { background: transparent; border: none; }
QFrame#OperationStatusOverlay { background: #1c2c40; border: 1px solid #59748c; border-radius: 7px; }
QLabel#OperationStatusOverlayTitle { color: #b7dcf5; background: transparent; font-weight: 600; }
QLabel#OperationStatusAction { background: transparent; color: #96d8ba; font-size: 13px; }
QLabel#OperationStatusAction[status='blocked'] { color: #ffb9b3; }
QLabel#OperationStatusAction[status='attention'] { color: #f4cb8a; }
QFrame#Sidebar { background: #0e1826; border: none; }
QLabel#Brand { color: white; font-size: 20px; font-weight: 700; }
QLabel#BrandSub, QLabel#SidebarFoot { color: #9bb5ce; font-size: 13px; }
QListWidget#Navigation { background: transparent; border: none; color: #a4bdd3; outline: none; }
QListWidget#Navigation::item { padding: 12px 12px; margin: 3px 0; border-radius: 7px; }
QListWidget#Navigation::item:selected { background: #215e81; color: white; }
QListWidget#Navigation::item:hover:!selected { background: #1a3047; }
QLabel#PageTitle { font-size: 20px; font-weight: 700; color: #eef5fe; }
QLabel#PageSubtitle, QLabel[role='muted'], QLabel[role='hint'] { color: #a0b6cc; font-size: 13px; }
QLabel[role='hint'] { padding: 7px 0; }
QLabel[role='warning'] { color: #e9bd73; background: #3b3327; border-radius: 6px; padding: 6px; }
QLabel#StatusPill { background: #293b51; color: #9eb4ca; border-radius: 8px; padding: 7px 10px; }
QLabel#StatusPill[healthy='true'] { background: #164a45; color: #67d8b9; }
QLabel#StatusPill[busy='true'] { background: #514123; color: #edc06d; }
QGroupBox { background: #1c2c40; border: 1px solid #32485f; border-radius: 9px; margin-top: 17px; padding: 14px 12px 9px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 5px; background: #142031; color: #9fbfd9; }
QGroupBox[compact='true'] { margin-top: 14px; padding: 8px 6px 6px; }
QFrame#Card { background: #1c2c40; border: 1px solid #32485f; border-radius: 9px; }
QFrame#GamepadPanel { background: #1c2c40; border: 1px solid #344a61; border-radius: 7px; }
QDialog#GamepadSettingsDialog { background: #142031; color: #d1deec; }
QLabel#GamepadStatus { background: #263a50; color: #c0d3e6; padding: 5px 7px; border-radius: 5px; }
QLabel#GamepadStatus[ready='true'] { background: #17483e; color: #91e3c0; }
QPlainTextEdit#GamepadRawInput { background: #0d1929; color: #dce8f5; border: 1px solid #344b63; border-radius: 5px; font-family: Consolas, 'Microsoft YaHei UI'; font-size: 14px; padding: 6px; }
QPushButton, QToolButton { background: #263a51; color: #c6daeb; border: 1px solid #3b536a; border-radius: 6px; padding: 7px 11px; font-weight: 500; }
QPushButton:hover, QToolButton:hover { background: #304d69; border-color: #6899bd; }
QPushButton#ViewerToggle:hover { background: #2a4561; color: #d2e8fc; border-color: #6899bd; }
QPushButton#ViewerToggle:checked { background: #244566; color: #90c9ff; border-color: #5689b3; font-weight: 600; }
QPushButton#ViewerToggle:checked:hover { background: #2c547c; color: #c8eaff; border-color: #6899bd; }
QPushButton:disabled { background: #233044; color: #536a80; border-color: #2c4056; }
QPushButton[role='primary'] { background: #297ab6; color: white; border-color: #297ab6; font-weight: 600; }
QPushButton[role='success'] { background: #118678; color: white; border-color: #118678; }
QPushButton[role='secondary'] { background: #50667e; color: white; border-color: #50667e; }
QPushButton[role='secondary']:hover { background: #607a97; }
QPushButton[role='slate'] { background: #6575aa; color: white; border-color: #6575aa; }
QPushButton[role='slate']:hover { background: #7586bd; }
QPushButton[role='calibration'] { background: #916bae; color: white; border-color: #916bae; }
QPushButton[role='calibration']:hover { background: #a17abe; }
QPushButton[role='danger'] { background: #ca3c46; color: white; border-color: #ca3c46; font-weight: 700; }
QPushButton#StopButton { min-width: 80px; min-height: 24px; font-size: 14px; }
QPushButton#PointShortcutButton { background: #22384f; color: #d2e4f3; border-color: #46627d; padding: 4px 8px; font-size: 14px; font-weight: 500; text-align: left; }
QPushButton#PointShortcutButton:hover { background: #2b4863; border-color: #6899bd; }
QPushButton#PointShortcutButton:pressed { background: #365672; }
QPushButton#PointShortcutButton:disabled { background: #233044; color: #8198ae; border-color: #30455b; }
QPushButton[role='danger']:disabled, QPushButton[role='primary']:disabled, QPushButton[role='success']:disabled, QPushButton[role='secondary']:disabled, QPushButton[role='slate']:disabled, QPushButton[role='calibration']:disabled { background: #293b50; color: #586f85; border-color: #293b50; }
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox { background: #142337; border: 1px solid #3a516a; border-radius: 5px; padding: 6px; min-height: 16px; selection-background-color: #287bba; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border-color: #4badd9; }
QSpinBox, QDoubleSpinBox { padding-right: 6px; }
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 14px; height: 10px; top: 3px; right: 3px; border: none; border-radius: 3px; background: transparent; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 14px; height: 10px; bottom: 3px; right: 3px; border: none; border-radius: 3px; background: transparent; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover, QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover { background: #304d69; }
QSpinBox::up-button:pressed, QSpinBox::down-button:pressed, QDoubleSpinBox::up-button:pressed, QDoubleSpinBox::down-button:pressed { background: #3b5e7e; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url("{{ICONS}}/spin-up-dark.svg"); width: 8px; height: 5px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url("{{ICONS}}/spin-down-dark.svg"); width: 8px; height: 5px; }
QComboBox { padding-right: 20px; }
QComboBox QAbstractItemView { background: #1a2c40; selection-background-color: #285373; }
QComboBox::drop-down { border: none; width: 18px; }
QCheckBox { spacing: 7px; padding: 5px 0; }
QCheckBox::indicator { width: 15px; height: 15px; border: 1px solid #59738a; border-radius: 4px; background: #172639; }
QCheckBox::indicator:checked { background: #188d7e; border-color: #188d7e; }
QSlider::groove:horizontal { height: 4px; background: #3a5168; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #3b94c4; }
QSlider::handle:horizontal { background: #d8e9f5; border: 2px solid #3b94c4; width: 10px; margin: -5px 0; border-radius: 6px; }
QTabWidget::pane { border: 1px solid #344a61; background: #1c2c40; border-radius: 7px; }
QTabWidget#MotionTabs, QTabWidget#MotorTabs { background: #142031; }
QWidget#MotionTabPage, QWidget#MotorTabPage { border: 1px solid #344a61; background: #1c2c40; border-radius: 7px; }
QTabBar::tab { background: #26374c; padding: 9px 15px; color: #95acc1; }
QTabBar::tab:selected { background: #1c2c40; color: #71bde8; border-bottom: 2px solid #4ea1d0; }
QTableWidget { background: #1a2b3e; alternate-background-color: #1e3147; border: 1px solid #344b63; border-radius: 6px; gridline-color: #2d4359; selection-background-color: #285575; selection-color: white; }
QTableWidget::item { padding: 6px; }
QHeaderView::section { background: #263a50; color: #a6c0d8; border: none; padding: 9px 6px; font-weight: 600; }
QWidget#TerminalContent, QDockWidget#TerminalDock { background: #142031; color: #d1deec; }
QFrame#TerminalFilterBar, QFrame#TerminalCommandBar { background: #1c2c40; border: 1px solid #32485f; border-radius: 7px; }
QPushButton#LogTypeButton { background: transparent; color: #c0d3e6; border-color: transparent; padding: 6px 9px; }
QPushButton#LogTypeButton:hover { background: #2d435c; border-color: #537391; }
QPushButton#LogTypeButton:checked { background: #297ab6; color: white; border-color: #4193cc; font-weight: 600; }
QLabel#LogRefreshStatus { background: #17483e; color: #91e3c0; border-radius: 5px; padding: 6px 10px; }
QLabel#LogRefreshStatus[paused='true'] { background: #4a3920; color: #ffcf84; }
QPushButton#LogPause:checked { background: #665022; color: #ffe0a5; border-color: #a27b32; }
QLineEdit#LogSearch, QLineEdit#CustomCommand { background: #0f1b2c; color: #e2edf8; font-size: 15px; }
QPlainTextEdit#LogView { background: #0d1929; color: #dce8f5; border: 1px solid #344b63; border-radius: 6px; font-family: Consolas, 'Microsoft YaHei UI'; font-size: 16px; padding: 8px; selection-background-color: #287bba; selection-color: white; }
QPlainTextEdit#OpenTestResult { background: #0d1929; color: #dce8f5; border: 1px solid #344b63; border-radius: 6px; font-family: 'Microsoft YaHei UI'; font-size: 14px; padding: 6px; selection-background-color: #287bba; selection-color: white; }
QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #415a71; border-radius: 4px; min-height: 25px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QSplitter::handle { background: #31445b; }
QStatusBar { background: #1b2a3e; color: #8ba6bf; border-top: 1px solid #314359; }
QToolTip { color: white; background: #2d4b66; border: none; padding: 6px; }
QWidget#OperationStatusFeedbackSlot { background: transparent; }
QFrame#ActionFeedbackNotice { background: #203e58; border: none; border-radius: 5px; }
QFrame#ActionFeedbackNotice[tone='success'] { background: #17473d; }
QFrame#ActionFeedbackNotice[tone='warning'] { background: #493a24; }
QFrame#ActionFeedbackNotice[tone='error'] { background: #512c34; }
QLabel#ActionFeedbackMessage, QLabel#ActionFeedbackNextStep { background: transparent; color: #d9ecff; font-size: 13px; padding: 0; }
QLabel#ActionFeedbackMessage { font-weight: 600; }
QLabel#ActionFeedbackMessage[tone='success'], QLabel#ActionFeedbackNextStep[tone='success'] { color: #a4ebd1; }
QLabel#ActionFeedbackMessage[tone='warning'], QLabel#ActionFeedbackNextStep[tone='warning'] { color: #ffe0a9; }
QLabel#ActionFeedbackMessage[tone='error'], QLabel#ActionFeedbackNextStep[tone='error'] { color: #ffd0d4; }
QLabel#ActionLastResult { background: transparent; color: #a8cce9; font-size: 13px; padding: 0; }
QLabel#ActionLastResult[tone='success'] { color: #8de0bf; }
QLabel#ActionLastResult[tone='warning'] { color: #ffd18c; }
QLabel#ActionLastResult[tone='error'] { color: #ffaeb7; }
QLineEdit[feedbackInvalid='true'], QSpinBox[feedbackInvalid='true'], QDoubleSpinBox[feedbackInvalid='true'] { border-color: #e3ae5b; background: #3e3227; }
QFrame#OperationStatusPanel[compact='true'] { border: none; border-radius: 7px; }
QWidget#MotionSystemToolbar[compact='true'] QPushButton, QWidget#MotionModeToolbar[compact='true'] QPushButton { padding: 4px 6px; min-height: 22px; }
QWidget#MotionModeToolbar[compact='true'] QComboBox { padding: 4px 20px 4px 6px; min-height: 22px; }
