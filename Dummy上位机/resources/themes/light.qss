QWidget { font-family: 'Microsoft YaHei UI'; font-size: 14px; color: #223248; }
QMainWindow, QWidget#Workspace { background: #f2f4f8; }
QMessageBox, QInputDialog { background: #f2f5f9; color: #223248; }
QMessageBox QLabel, QInputDialog QLabel { background: transparent; color: #223248; font-size: 15px; padding: 2px 0; }
QMessageBox QDialogButtonBox, QInputDialog QDialogButtonBox { background: transparent; }
QMessageBox QPushButton, QInputDialog QPushButton { color: #314e6b; background: #ffffff; border: 1px solid #b9cbdc; font-size: 14px; padding: 8px 14px; min-width: 58px; }
QMessageBox QPushButton:hover, QInputDialog QPushButton:hover { background: #e7f2fb; border-color: #87afcf; }
QMessageBox QPushButton:default, QInputDialog QPushButton:default { color: white; background: #286caa; border-color: #286caa; font-weight: 600; }
QMessageBox QTextEdit, QInputDialog QTextEdit, QInputDialog QPlainTextEdit { color: #223248; background: #ffffff; border: 1px solid #b9cbdc; font-size: 15px; }
QFrame#TopBar { background: #ffffff; border-bottom: 1px solid #dce4ed; }
QFrame#TopBar QLabel#StatusPill { padding: 0; }
QFrame#OperationStatusPanel { background: #edf4fa; border-bottom: 1px solid #ccdae7; }
QFrame#OperationStatusPanel[tone='warning'] { background: #fff5e4; border-color: #e7d1a5; }
QFrame#OperationStatusPanel[tone='error'] { background: #fff0ef; border-color: #e8bbb8; }
QLabel#OperationStatusTitle { color: #244d70; background: transparent; }
QLabel#OperationStatusTitle[tone='success'] { color: #147359; }
QLabel#OperationStatusTitle[tone='warning'] { color: #815108; }
QLabel#OperationStatusTitle[tone='error'] { color: #a82d31; }
QLabel#OperationStatusReason, QLabel#OperationStatusNextStep { background: transparent; color: #334e68; font-size: 13px; }
QLabel#OperationStatusElapsed { background: transparent; color: #536b81; font-size: 13px; }
QToolButton#OperationStatusDetailsButton { background: transparent; color: #315c7c; border: none; padding: 1px 5px; }
QToolButton#OperationStatusDetailsButton:hover { background: #dbeaf5; }
QWidget#OperationStatusConditions, QScrollArea#OperationStatusDetails { background: transparent; border: none; }
QFrame#OperationStatusOverlay { background: #ffffff; border: 1px solid #a9bfd2; border-radius: 7px; }
QLabel#OperationStatusOverlayTitle { color: #244d70; background: transparent; font-weight: 600; }
QLabel#OperationStatusAction { background: transparent; color: #285c4b; font-size: 13px; }
QLabel#OperationStatusAction[status='blocked'] { color: #933d34; }
QLabel#OperationStatusAction[status='attention'] { color: #80550f; }
QFrame#Sidebar { background: #142337; border: none; }
QLabel#Brand { color: #ffffff; font-size: 20px; font-weight: 700; }
QLabel#BrandSub { color: #a8bdd1; font-size: 13px; letter-spacing: 1px; }
QLabel#SidebarFoot { color: #a8bdd1; font-size: 13px; }
QListWidget#Navigation { background: transparent; border: none; color: #b9c9d9; outline: none; }
QListWidget#Navigation::item { padding: 12px 12px; margin: 3px 0; border-radius: 7px; }
QListWidget#Navigation::item:selected { background: #245879; color: white; }
QListWidget#Navigation::item:hover:!selected { background: #20344b; }
QLabel#PageTitle { font-size: 20px; font-weight: 700; color: #152b45; }
QLabel#PageSubtitle, QLabel[role='muted'] { color: #62758b; font-size: 13px; }
QLabel[role='hint'] { color: #5e738a; font-size: 13px; padding: 7px 0; }
QLabel[role='warning'] { color: #a86a16; padding: 6px; background: #fff6e7; border-radius: 6px; }
QLabel#StatusPill { background: #eef3f8; color: #63778d; border-radius: 8px; padding: 7px 10px; }
QLabel#StatusPill[healthy='true'] { background: #e6f5ef; color: #168267; }
QLabel#StatusPill[busy='true'] { background: #fff3df; color: #9f671a; }
QGroupBox { background: #ffffff; border: 1px solid #dce5ee; border-radius: 9px; margin-top: 17px; padding: 14px 12px 9px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 5px; background: #f2f5f9; color: #35506d; }
QGroupBox[compact='true'] { margin-top: 14px; padding: 8px 6px 6px; }
QFrame#Card { background: #ffffff; border: 1px solid #dce5ee; border-radius: 9px; }
QFrame#GamepadPanel { background: #ffffff; border: 1px solid #dce5ee; border-radius: 7px; }
QDialog#GamepadSettingsDialog { background: #f2f5f9; color: #223248; }
QLabel#GamepadStatus { background: #eef3f8; color: #3b5169; padding: 5px 7px; border-radius: 5px; }
QLabel#GamepadStatus[ready='true'] { background: #e6f5ef; color: #147359; }
QPlainTextEdit#GamepadRawInput { background: #ffffff; color: #223248; border: 1px solid #b9cbdc; border-radius: 5px; font-family: Consolas, 'Microsoft YaHei UI'; font-size: 14px; padding: 6px; }
QPushButton, QToolButton { background: #ffffff; color: #3b5169; border: 1px solid #d4dfe9; border-radius: 6px; padding: 7px 11px; font-weight: 500; }
QPushButton:hover, QToolButton:hover { background: #edf5fc; border-color: #87afcf; }
QPushButton#ViewerToggle:hover { background: #edf5fc; color: #236da9; border-color: #87afcf; }
QPushButton#ViewerToggle:checked { background: #e7f1fd; color: #2563b0; border-color: #8bb4d9; font-weight: 600; }
QPushButton#ViewerToggle:checked:hover { background: #d8eafa; color: #174e83; border-color: #659dca; }
QPushButton:pressed { background: #e0edf8; }
QPushButton:disabled { background: #f0f3f6; color: #acb8c5; border-color: #e4e9ef; }
QPushButton[role='primary'] { background: #286caa; color: white; border-color: #286caa; font-weight: 600; }
QPushButton[role='primary']:hover { background: #1d5e99; }
QPushButton[role='success'] { background: #138978; color: white; border-color: #138978; }
QPushButton[role='success']:hover { background: #0b7769; }
QPushButton[role='secondary'] { background: #526579; color: white; border-color: #526579; }
QPushButton[role='secondary']:hover { background: #3f5368; }
QPushButton[role='slate'] { background: #6473a3; color: white; border-color: #6473a3; }
QPushButton[role='slate']:hover { background: #53638f; }
QPushButton[role='calibration'] { background: #8963aa; color: white; border-color: #8963aa; }
QPushButton[role='calibration']:hover { background: #745092; }
QPushButton[role='danger'] { background: #d74348; color: white; border-color: #d74348; font-weight: 700; }
QPushButton[role='danger']:hover { background: #be3339; }
QPushButton[role='danger']:disabled, QPushButton[role='primary']:disabled, QPushButton[role='success']:disabled, QPushButton[role='secondary']:disabled, QPushButton[role='slate']:disabled, QPushButton[role='calibration']:disabled { background: #dee5ec; color: #a2afbc; border-color: #dee5ec; }
QPushButton#StopButton { min-width: 80px; min-height: 24px; font-size: 14px; }
QPushButton#PointShortcutButton { background: #f4f8fc; color: #314e6b; border-color: #cbddeb; padding: 4px 8px; font-size: 14px; font-weight: 500; text-align: left; }
QPushButton#PointShortcutButton:hover { background: #e7f2fb; border-color: #87afcf; }
QPushButton#PointShortcutButton:pressed { background: #dcecf8; }
QPushButton#PointShortcutButton:disabled { background: #f0f3f6; color: #8293a5; border-color: #e0e6ec; }
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox { background: #ffffff; border: 1px solid #d3dfeb; border-radius: 5px; padding: 6px; min-height: 16px; selection-background-color: #2d7ab6; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border: 1px solid #348cc5; }
QSpinBox, QDoubleSpinBox { padding-right: 6px; }
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 14px; height: 10px; top: 3px; right: 3px; border: none; border-radius: 3px; background: transparent; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 14px; height: 10px; bottom: 3px; right: 3px; border: none; border-radius: 3px; background: transparent; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover, QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover { background: #edf5fc; }
QSpinBox::up-button:pressed, QSpinBox::down-button:pressed, QDoubleSpinBox::up-button:pressed, QDoubleSpinBox::down-button:pressed { background: #dcecf8; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url("{{ICONS}}/spin-up-light.svg"); width: 8px; height: 5px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url("{{ICONS}}/spin-down-light.svg"); width: 8px; height: 5px; }
QComboBox { padding-right: 20px; }
QComboBox QAbstractItemView { background: white; selection-background-color: #e6f1fb; selection-color: #1b4c79; }
QComboBox::drop-down { border: none; width: 18px; }
QCheckBox { spacing: 7px; padding: 5px 0; }
QCheckBox::indicator { width: 15px; height: 15px; border: 1px solid #b9cbdc; border-radius: 4px; background: white; }
QCheckBox::indicator:checked { background: #168a7b; border-color: #168a7b; }
QSlider:horizontal { min-height: 22px; }
QSlider::groove:horizontal { height: 4px; background: #dce6ef; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #328bbb; border-radius: 2px; }
QSlider::handle:horizontal { background: white; border: 2px solid #328bbb; width: 10px; margin: -9px 0; border-radius: 4px; }
QTabWidget::pane { border: 1px solid #dce5ee; background: #ffffff; border-radius: 7px; }
QTabWidget#MotionTabs, QTabWidget#MotorTabs { background: #f2f5f9; }
QWidget#MotionTabPage, QWidget#MotorTabPage { border: 1px solid #dce5ee; background: #ffffff; border-radius: 7px; }
QTabBar::tab { background: #e8eef5; padding: 9px 15px; border: none; color: #62778c; }
QTabBar::tab:selected { background: #ffffff; color: #236fa7; border-bottom: 2px solid #236fa7; }
QTableWidget { background: white; alternate-background-color: #f7fafc; border: 1px solid #dce5ee; border-radius: 6px; gridline-color: #ebeff4; selection-background-color: #e4f0fa; selection-color: #1c4e78; }
QTableWidget::item { padding: 6px; }
QHeaderView::section { background: #eff4f8; color: #536c83; border: none; border-bottom: 1px solid #dce5ee; padding: 9px 6px; font-weight: 600; }
QWidget#TerminalContent, QDockWidget#TerminalDock { background: #f2f5f9; color: #223248; }
QFrame#TerminalFilterBar, QFrame#TerminalCommandBar { background: #ffffff; border: 1px solid #d4dfe9; border-radius: 7px; }
QPushButton#LogTypeButton { background: transparent; color: #3b5169; border-color: transparent; padding: 6px 9px; }
QPushButton#LogTypeButton:hover { background: #edf5fc; border-color: #87afcf; }
QPushButton#LogTypeButton:checked { background: #286caa; color: white; border-color: #286caa; font-weight: 600; }
QLabel#LogRefreshStatus { background: #e5f5ec; color: #1c7549; border-radius: 5px; padding: 6px 10px; }
QLabel#LogRefreshStatus[paused='true'] { background: #fff1d5; color: #8d5a0d; }
QPushButton#LogPause:checked { background: #ffefca; color: #80500a; border-color: #d6ad58; }
QLineEdit#LogSearch, QLineEdit#CustomCommand { background: #ffffff; color: #223248; font-size: 15px; }
QPlainTextEdit#LogView { background: #ffffff; color: #24354b; border: 1px solid #d4dfe9; border-radius: 6px; font-family: Consolas, 'Microsoft YaHei UI'; font-size: 16px; padding: 8px; selection-background-color: #2d7ab6; selection-color: white; }
QPlainTextEdit#OpenTestResult { background: #ffffff; color: #24354b; border: 1px solid #d4dfe9; border-radius: 6px; font-family: 'Microsoft YaHei UI'; font-size: 14px; padding: 6px; selection-background-color: #2d7ab6; selection-color: white; }
QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #c6d3e0; border-radius: 4px; min-height: 25px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QSplitter::handle { background: #e0e7ef; }
QStatusBar { background: white; color: #718298; border-top: 1px solid #e0e7ef; }
QToolTip { color: #ffffff; background: #263d55; border: none; padding: 6px; }
QLabel#ParameterReadback { color: #607489; font-size: 12px; padding: 0; }
QLabel#ParameterEditStatus { color: #89611a; font-size: 12px; padding: 0; }
QPushButton#ParameterRestore { padding: 3px 6px; font-size: 12px; }
QLineEdit[parameterDirty='true'], QDoubleSpinBox[parameterDirty='true'] { border-color: #c7943f; }
QLineEdit[parameterRangeError='true'], QDoubleSpinBox[parameterRangeError='true'] { border-color: #c45146; }
QWidget#OperationStatusFeedbackSlot { background: transparent; }
QFrame#ActionFeedbackNotice { background: #dcecf8; border: none; border-radius: 5px; }
QFrame#ActionFeedbackNotice[tone='success'] { background: #daf0e5; }
QFrame#ActionFeedbackNotice[tone='warning'] { background: #fff0cf; }
QFrame#ActionFeedbackNotice[tone='error'] { background: #fbe1e3; }
QLabel#ActionFeedbackMessage, QLabel#ActionFeedbackNextStep { background: transparent; color: #244f74; font-size: 13px; padding: 0; }
QLabel#ActionFeedbackMessage { font-weight: 600; }
QLabel#ActionFeedbackMessage[tone='success'], QLabel#ActionFeedbackNextStep[tone='success'] { color: #165e45; }
QLabel#ActionFeedbackMessage[tone='warning'], QLabel#ActionFeedbackNextStep[tone='warning'] { color: #774b08; }
QLabel#ActionFeedbackMessage[tone='error'], QLabel#ActionFeedbackNextStep[tone='error'] { color: #9a2834; }
QLabel#ActionLastResult { background: transparent; color: #315f84; font-size: 13px; padding: 0; }
QLabel#ActionLastResult[tone='success'] { color: #146449; }
QLabel#ActionLastResult[tone='warning'] { color: #88550a; }
QLabel#ActionLastResult[tone='error'] { color: #a52e3a; }
QLineEdit[feedbackInvalid='true'], QSpinBox[feedbackInvalid='true'], QDoubleSpinBox[feedbackInvalid='true'] { border-color: #c0862e; background: #fff5df; }
QFrame#OperationStatusPanel[compact='true'] { border: none; border-radius: 7px; }
QWidget#MotionSystemToolbar[compact='true'] QPushButton, QWidget#MotionModeToolbar[compact='true'] QPushButton { padding: 4px 6px; min-height: 22px; }
QWidget#MotionModeToolbar[compact='true'] QComboBox { padding: 4px 20px 4px 6px; min-height: 22px; }
QLabel#PidParameterHelp { color: #496078; font-size: 13px; background: transparent; padding: 0; }

/* Parameter panels: hierarchy and status colors never change box geometry. */
QWidget[parameterPanel='true'] QLabel[parameterCaption='true'] { color: #31465c; font-size: 14px; font-weight: 600; padding: 0; }
QWidget[parameterPanel='true'] QWidget[parameterInput='true'], QWidget[parameterPanel='true'] QWidget[parameterInput='true'] QLineEdit { color: #182e45; font-size: 16px; font-weight: 500; }
QWidget[parameterPanel='true'] QLabel#ParameterReadback, QWidget[parameterPanel='true'] QLabel#ParameterEditStatus, QWidget[parameterPanel='true'] QLabel[parameterStatus='true'] { color: #6d7d8d; font-size: 12px; font-weight: 400; background: transparent; padding: 0; }
QWidget[parameterPanel='true'] QLabel#ParameterReadback[parameterTone='muted'], QWidget[parameterPanel='true'] QLabel#ParameterEditStatus[parameterTone='muted'], QWidget[parameterPanel='true'] QLabel[parameterStatus='true'][parameterTone='muted'] { color: #6d7d8d; }
QWidget[parameterPanel='true'] QLabel#ParameterReadback[parameterTone='success'], QWidget[parameterPanel='true'] QLabel#ParameterEditStatus[parameterTone='success'], QWidget[parameterPanel='true'] QLabel[parameterStatus='true'][parameterTone='success'] { color: #36785c; }
QWidget[parameterPanel='true'] QLabel#ParameterEditStatus[parameterTone='warning'], QWidget[parameterPanel='true'] QLabel[parameterStatus='true'][parameterTone='warning'] { color: #93691d; }
QWidget[parameterPanel='true'] QLabel#ParameterEditStatus[parameterTone='error'], QWidget[parameterPanel='true'] QLabel[parameterStatus='true'][parameterTone='error'] { color: #b33b43; }
QWidget[parameterPanel='true'] QLabel[parameterHelp='true'], QWidget[parameterPanel='true'] QLabel#PidParameterHelp { color: #52677d; font-size: 13px; font-weight: 400; background: transparent; padding: 0; }
QWidget[parameterPanel='true'] QLineEdit[parameterTone='muted'], QWidget[parameterPanel='true'] QSpinBox[parameterTone='muted'], QWidget[parameterPanel='true'] QDoubleSpinBox[parameterTone='muted'] { border-color: #c9d5e1; }
QWidget[parameterPanel='true'] QLineEdit[parameterTone='success'], QWidget[parameterPanel='true'] QSpinBox[parameterTone='success'], QWidget[parameterPanel='true'] QDoubleSpinBox[parameterTone='success'] { border-color: #9dbba9; }
QWidget[parameterPanel='true'] QLineEdit[parameterTone='warning'], QWidget[parameterPanel='true'] QSpinBox[parameterTone='warning'], QWidget[parameterPanel='true'] QDoubleSpinBox[parameterTone='warning'] { border-color: #c69a4a; }
QWidget[parameterPanel='true'] QLineEdit[parameterTone='error'], QWidget[parameterPanel='true'] QSpinBox[parameterTone='error'], QWidget[parameterPanel='true'] QDoubleSpinBox[parameterTone='error'] { border-color: #c65c62; background: #fff5f5; }
QWidget[parameterPanel='true'] QLineEdit[parameterInput='true']:focus, QWidget[parameterPanel='true'] QSpinBox[parameterInput='true']:focus, QWidget[parameterPanel='true'] QDoubleSpinBox[parameterInput='true']:focus { border-color: #348cc5; }
QWidget[parameterPanel='true'] QLineEdit[parameterTone='error']:focus, QWidget[parameterPanel='true'] QSpinBox[parameterTone='error']:focus, QWidget[parameterPanel='true'] QDoubleSpinBox[parameterTone='error']:focus { border-color: #b33b43; }
QWidget[parameterPanel='true'] QPushButton[parameterAction] { min-height: 34px; max-height: 34px; padding: 0 12px; border-width: 1px; border-radius: 5px; font-size: 14px; font-weight: 500; }
QWidget[parameterPanel='true'] QPushButton#ParameterRestore[parameterAction] { min-height: 34px; max-height: 34px; padding: 0 12px; font-size: 14px; }
QWidget[parameterPanel='true'] QPushButton[parameterAction='primary'] { color: #ffffff; background: #286caa; border-color: #286caa; font-weight: 600; }
QWidget[parameterPanel='true'] QPushButton[parameterAction='primary']:hover { background: #1f609c; border-color: #1f609c; }
QWidget[parameterPanel='true'] QPushButton[parameterAction='primary']:pressed { background: #194f82; border-color: #194f82; }
QWidget[parameterPanel='true'] QPushButton[parameterAction='normal'] { color: #315675; background: #f5f9fd; border-color: #bdcfdf; }
QWidget[parameterPanel='true'] QPushButton[parameterAction='normal']:hover { background: #e8f2fb; border-color: #88acce; }
QWidget[parameterPanel='true'] QPushButton[parameterAction='normal']:pressed { background: #dcebf7; border-color: #78a2c6; }
QWidget[parameterPanel='true'] QPushButton[parameterAction='quiet'] { color: #60758a; background: transparent; border-color: #d5dfe9; }
QWidget[parameterPanel='true'] QPushButton[parameterAction='quiet']:hover { color: #315675; background: #f0f5fa; border-color: #b6c9d9; }
QWidget[parameterPanel='true'] QPushButton[parameterAction='quiet']:pressed { background: #e5edf5; border-color: #a6bdcf; }
QWidget[parameterPanel='true'] QPushButton[parameterAction='danger']:hover { background: #be3339; border-color: #be3339; }
QWidget[parameterPanel='true'] QPushButton[parameterAction='danger']:pressed { background: #a62b31; border-color: #a62b31; }
QWidget[parameterPanel='true'] QPushButton[parameterAction]:focus { border-color: #337fb7; }
QWidget[parameterPanel='true'] QPushButton[parameterAction='primary']:focus { border-color: #174b78; }
QWidget[parameterPanel='true'] QPushButton[parameterAction='danger']:focus { border-color: #8f2027; }
QWidget[parameterPanel='true'] QPushButton[parameterAction]:disabled { color: #9aa9b8; background: #eef2f6; border-color: #dce4ec; }

/* Workstation chrome and motion page. Parameter and teaching defaults stay scoped. */
QWidget#Workspace { background: #f2f4f8; }
QStackedWidget#Pages { background: transparent; border: none; }
QWidget#PageHost { background: #ffffff; }
QFrame#PageSurface { background: #f2f4f8; border: none; }
QWidget#MotionWorkspace { background: transparent; border: none; }
QFrame#TopBar, QFrame#Sidebar { background: #ffffff; border: none; }
QFrame#TopBar { border-bottom: none; }
QWidget#ConnectionControls QLabel { background: transparent; font-size: 12px; color: #737e91; }
QWidget#ConnectionControls QComboBox { background: #ffffff; color: #202936; border: 1px solid #dce0e9; padding: 3px 20px 3px 6px; font-size: 13px; }
QWidget#ConnectionControls QPushButton { background: #f5f6fa; color: #202936; border: 1px solid #dce0e9; padding: 3px 8px; font-size: 13px; font-weight: 400; }
QWidget#ConnectionControls QLabel#StatusPill { background: transparent; border: none; padding: 0; }
QWidget#ConnectionControls QLabel#StatusPill[healthy='true'] { color: #4a806d; }
QFrame#Sidebar { border-right: none; }
QFrame#WorkstationBrand { border: none; background: transparent; }
QWidget#WorkstationMark { background: transparent; border: none; padding: 0; }
QPushButton#DeviceConnectionButton { background: transparent; color: #202936; border: none; text-align: left; padding: 4px 6px; font-size: 14px; }
QPushButton#DeviceConnectionButton:hover { background: #f5f6fa; }
QLabel#WorkstationState { background: transparent; color: #737e91; border: none; padding: 0; font-size: 17px; }
QLabel#WorkstationState[healthy='true'] { color: #4a806d; }
QLabel#WorkstationState[busy='true'] { color: #987027; }
QLabel#ControlSourceLabel { color: #737e91; background: transparent; border-left: 1px solid #dce0e9; padding-left: 12px; font-size: 17px; }
QPushButton#StopButton { background: #b4484e; border: 1px solid #b4484e; color: white; border-radius: 16px; font-size: 20px; font-weight: 600; padding: 4px 12px; }
QPushButton#StopButton:hover { background: #c8535b; border-color: #c8535b; }
QLabel#SidebarGroup { color: #737e91; background: transparent; font-size: 12px; padding: 5px 5px; }
QLabel#SidebarFoot { color: #737e91; background: transparent; font-size: 10px; border-top: 1px solid #dce0e9; padding: 12px 2px 0 2px; }
QPushButton#SidebarItem, QPushButton#SidebarTerminal { color: #737e91; background: transparent; border: none; border-radius: 10px; text-align: center; padding: 0; }
QPushButton#SidebarItem:checked { color: #526ce0; background: #e9eefe; }
QPushButton#SidebarItem:hover, QPushButton#SidebarTerminal:hover { background: #f5f6fa; color: #202936; }
QFrame#WorkstationPopover { background: #ffffff; border: 1px solid #dce0e9; border-radius: 8px; }
QFrame#WorkstationPopover QLabel { background: transparent; color: #202936; }
QLabel#PopoverTitle { font-size: 15px; font-weight: 600; }
QMenu#WorkstationMenu { color: #202936; background: #ffffff; border: 1px solid #dce0e9; padding: 5px; }
QMenu#WorkstationMenu::item { padding: 8px 18px; }
QMenu#WorkstationMenu::item:selected { background: #e9eefe; color: #526ce0; }
QFrame#WorkstationPopover QPushButton { background: #f5f6fa; color: #202936; border: 1px solid #dce0e9; padding: 4px 8px; }
QFrame#WorkstationPopover QComboBox, QFrame#WorkstationPopover QDoubleSpinBox { background: #ffffff; color: #202936; border: 1px solid #dce0e9; padding: 4px 6px; }
QWidget#MotionWorkspace QLabel { color: #202936; background: transparent; }
QWidget#MotionWorkspace QLabel#PageTitle { font-size: 24px; font-weight: 600; }
QWidget#MotionWorkspace QLabel#PageSubtitle { color: #737e91; font-size: 13px; }
QWidget#MotionWorkspace QFrame#Card, QWidget#MotionWorkspace QWidget#TargetEditorCard { background: #ffffff; border: 1px solid #dce0e9; border-radius: 10px; }
QWidget#MotionWorkspace QFrame#Card[motionScene='true'] { border-bottom: none; }
QWidget#MotionWorkspace QPushButton { color: #202936; background: #ffffff; border: 1px solid #dce0e9; border-radius: 7px; padding: 3px 10px; font-size: 13px; font-weight: 400; }
QWidget#MotionWorkspace QPushButton:hover { background: #f5f6fa; border-color: #737e91; }
QWidget#MotionWorkspace QPushButton:disabled { color: #a8afbc; background: #ffffff; border-color: #dce0e9; }
QWidget#MotionWorkspace QPushButton[role='primary'] { color: white; background: #4d68dc; border-color: #4d68dc; font-weight: 600; }
QWidget#MotionWorkspace QPushButton[role='primary']:hover { background: #526ce0; border-color: #526ce0; }
QWidget#MotionWorkspace QPushButton[role='primary']:disabled { background: #f5f6fa; color: #a8afbc; border-color: #dce0e9; }
QWidget#MotionWorkspace QPushButton[motionAction='enable'] { background: #eaf5ed; border-color: #b7d7bf; color: #336d45; }
QWidget#MotionWorkspace QPushButton[motionAction='enable']:hover { background: #dceddf; border-color: #8bb997; }
QWidget#MotionWorkspace QPushButton[motionAction='disable'] { background: #faedf0; border-color: #e2bdc6; color: #9b4b5e; }
QWidget#MotionWorkspace QPushButton[motionAction='disable']:hover { background: #f4dfe5; border-color: #c992a0; }
QWidget#MotionWorkspace QPushButton[motionAction='home'] { background: #edf3ff; border-color: #c3d3f1; color: #2f5eaa; }
QWidget#MotionWorkspace QPushButton[motionAction='home']:hover { background: #e2ecff; border-color: #90b0df; }
QWidget#MotionWorkspace QPushButton[motionAction='home']:pressed { background: #d7e4fb; }
QWidget#MotionWorkspace QPushButton[motionAction='rest'] { background: #e9f5ef; border-color: #b7d9ca; color: #2f735c; }
QWidget#MotionWorkspace QPushButton[motionAction='rest']:hover { background: #dcefe5; border-color: #88bba6; }
QWidget#MotionWorkspace QPushButton[motionAction='rest']:pressed { background: #d0e7dc; }
QWidget#MotionWorkspace QPushButton[motionAction='calibrate'] { background: #fff4e3; border-color: #e8cc9b; color: #956422; }
QWidget#MotionWorkspace QPushButton[motionAction='calibrate']:hover { background: #ffebca; border-color: #cfaa6a; }
QWidget#MotionWorkspace QPushButton[motionAction='calibrate']:pressed { background: #f6deb5; }
QWidget#MotionWorkspace QPushButton[motionAction]:disabled { background: #f5f6fa; border-color: #dce0e9; color: #b0b8c5; }
QWidget#MotionWorkspace QWidget#SceneToolbar { border-bottom: 1px solid #dce0e9; }
QWidget#MotionWorkspace QPushButton#CameraButton { color: #737e91; background: transparent; border: none; padding: 3px 5px; }
QWidget#MotionWorkspace QPushButton#CameraButton:hover { color: #526ce0; background: #e9eefe; }
QWidget#MotionWorkspace QPushButton#ViewerToggle { color: #737e91; background: #ffffff; border: 1px solid #dce0e9; padding: 3px 8px; font-size: 13px; }
QWidget#MotionWorkspace QPushButton#ViewerToggle:hover { color: #4059c4; background: #f2f5ff; border-color: #90a1e5; }
QWidget#MotionWorkspace QPushButton#ViewerToggle:checked { color: #526ce0; background: #e9eefe; border-color: #b8c5ee; }
QWidget#MotionWorkspace QPushButton#ViewerToggle:disabled { color: #b0b8c5; background: #f5f6fa; border-color: #dce0e9; }
QWidget#MotionWorkspace QComboBox, QWidget#MotionWorkspace QDoubleSpinBox { background: #ffffff; color: #202936; border: 1px solid #dce0e9; border-radius: 6px; padding: 2px 7px; min-height: 16px; font-size: 14px; }
QWidget#MotionWorkspace QComboBox { padding-right: 19px; }
QWidget#MotionWorkspace QDoubleSpinBox { qproperty-alignment: AlignRight; }
QWidget#MotionWorkspace QComboBox:focus, QWidget#MotionWorkspace QDoubleSpinBox:focus { border-color: #526ce0; }
QWidget#MotionWorkspace QComboBox:disabled, QWidget#MotionWorkspace QDoubleSpinBox:disabled { color: #a8afbc; }
QWidget#MotionWorkspace QCheckBox { color: #737e91; padding: 0; font-size: 12px; spacing: 5px; }
QWidget#MotionWorkspace QLabel[role='muted'], QWidget#MotionWorkspace QLabel#MotionSceneCaption { color: #737e91; font-size: 12px; }
QWidget#MotionWorkspace QLabel#MotionSceneCaption { padding: 0 10px; }
QWidget#MotionWorkspace QWidget[motionAxis='true'] { border-bottom: 1px solid #e9ebf1; }
QWidget#MotionWorkspace QWidget[motionAxis='true'] QLabel { border: none; font-size: 13px; }
QWidget#MotionWorkspace QWidget[motionAxis='true'] QLabel[role='muted'] { color: #737e91; }
QWidget#MotionWorkspace QTabWidget#MotionTabs, QWidget#MotionWorkspace QStackedWidget#MotionInputStack { background: transparent; border: none; }
QWidget#MotionWorkspace QTabWidget#MotionTabs::pane { background: #ffffff; border: none; border-top: 1px solid #dce0e9; }
QWidget#MotionWorkspace QWidget#MotionTabPage { background: transparent; border: none; }
QWidget#MotionWorkspace QTabBar::tab { color: #737e91; background: transparent; border: none; border-bottom: 2px solid transparent; padding: 8px 14px; font-size: 13px; }
QWidget#MotionWorkspace QTabBar::tab:selected { color: #526ce0; border-bottom-color: #4d68dc; font-weight: 600; }
QWidget#MotionWorkspace QLabel#TargetEditorTitle { font-size: 16px; }
QFrame#MotionModeMenu { background: #ffffff; border: 1px solid #bdc8ec; border-radius: 8px; }
QFrame#MotionModeMenu QPushButton#MotionModeItem { color: #202936; background: transparent; border: none; border-radius: 5px; padding: 4px 12px; font-size: 13px; text-align: left; }
QFrame#MotionModeMenu QPushButton#MotionModeItem[currentMode='true'] { color: #425ac0; background: #edf1ff; font-weight: 600; }
QFrame#MotionModeMenu QPushButton#MotionModeItem:hover { color: #4059c4; background: #e4eafe; }
QFrame#MotionModeMenu QPushButton#MotionModeItem:disabled { color: #a1a9b8; background: transparent; }
QWidget#MotionWorkspace QPushButton#MotionModeButton { color: #425ac0; background: #edf1ff; border: 1px solid #bdc8ec; padding: 3px 8px; font-size: 13px; }
QWidget#MotionWorkspace QPushButton#MotionModeButton:hover { background: #e4eafe; border-color: #8d9ed7; }
QWidget#MotionWorkspace QPushButton#MotionModeButton:pressed { background: #dbe3fd; }
QWidget#MotionWorkspace QPushButton#MotionModeButton:disabled { color: #a1a9b8; background: #f5f6f9; border-color: #e1e5ed; }
QWidget#MotionWorkspace QGroupBox#MotionGripper { background: #f5f6fa; border: none; border-top: 1px solid #dce0e9; border-radius: 0; border-bottom-left-radius: 9px; border-bottom-right-radius: 9px; margin-top: 0; padding: 0; }
QWidget#MotionWorkspace QGroupBox#MotionGripper::title { background: transparent; padding: 0; }
QWidget#MotionWorkspace QGroupBox#MotionGripper QWidget[motionAxis='true'] { border: none; }
QWidget#MotionWorkspace QLabel#GripperTitle { color: #737e91; font-size: 12px; font-weight: 400; }
QWidget#MotionWorkspace QPushButton#GripperMoreButton { color: #737e91; background: transparent; border: none; padding: 0; }
QWidget#MotionWorkspace QPushButton#GripperSendPosition { padding: 2px 5px; font-size: 12px; }
QWidget#MotionWorkspace QFrame#QuickPointsPanel { background: transparent; border: none; border-top: 1px solid #dce0e9; }
QWidget#MotionWorkspace QPushButton#PointShortcutButton { color: #202936; background: #ffffff; border-color: #dce0e9; padding: 3px 9px; font-size: 12px; text-align: left; }
QWidget#MotionWorkspace QPushButton#PointShortcutButton:hover { background: #e9eefe; border-color: #4d68dc; }
QWidget#MotionWorkspace QPushButton#PointShortcutButton:checked { background: #e9eefe; border-color: #4d68dc; }
QWidget#MotionWorkspace QPushButton#PointShortcutButton:disabled { color: #a8afbc; background: #ffffff; }
QWidget#MotionWorkspace QPushButton#QuickPointsToggle, QWidget#MotionWorkspace QPushButton#PointTextAction { color: #737e91; background: transparent; border: none; padding: 3px; font-size: 12px; }
QWidget#MotionWorkspace QSlider::groove:horizontal { background: #dce0e9; height: 3px; border-radius: 1px; }
QWidget#MotionWorkspace QSlider::sub-page:horizontal { background: #dce0e9; }
QWidget#MotionWorkspace QSlider::handle:horizontal { background: #ffffff; border: 2px solid #526ce0; border-radius: 4px; width: 10px; margin: -9px 0; }
QWidget#MotionWorkspace QSplitter::handle { background: transparent; }
QWidget#MotionWorkspace[compact='true'] QLabel#PageTitle { font-size: 21px; }
QWidget#MotionWorkspace[compact='true'] QTabBar::tab { padding: 5px 8px; font-size: 12px; }
QWidget#MotionWorkspace[compact='true'] QDoubleSpinBox { font-size: 12px; padding: 1px 5px; }
QWidget#MotionWorkspace[compact='true'] QComboBox { font-size: 12px; padding-top: 1px; padding-bottom: 1px; }
QWidget#MotionWorkspace[compact='true'] QWidget[motionAxis='true'] QLabel { font-size: 12px; }
QWidget#MotionWorkspace[compact='true'] QWidget#MotionAxisColumns QLabel { font-size: 10px; }
QFrame#OperationStatusPanel[motionHeader='true'] { background: transparent; border: none; border-radius: 0; }
QFrame#OperationStatusPanel[motionHeader='true'][tone='warning'], QFrame#OperationStatusPanel[motionHeader='true'][tone='error'] { background: transparent; }
QFrame#OperationStatusPanel[motionHeader='true'] QLabel#OperationStatusTitle { color: #202936; font-size: 13px; font-weight: 500; }
QFrame#TopBar QLabel#OperationStatusTitle { background: transparent; border: none; color: #202936; font-size: 17px; font-weight: 500; padding: 0; }
QFrame#TopBar QLabel#OperationStatusTitle[tone='success'] { color: #4a806d; }
QFrame#TopBar QLabel#OperationStatusTitle[tone='warning'] { color: #987027; }
QFrame#TopBar QLabel#OperationStatusTitle[tone='error'] { color: #b74450; }
QWidget#CustomTitleBar QFrame#CaptionControls { background: transparent; border: none; }
QWidget#CustomTitleBar QLabel#OperationStatusTitle { background: transparent; border: none; color: #202936; font-size: 17px; font-weight: 500; padding: 0; }
QWidget#CustomTitleBar QLabel#OperationStatusTitle[tone='success'] { color: #4a806d; }
QWidget#CustomTitleBar QLabel#OperationStatusTitle[tone='warning'] { color: #987027; }
QWidget#CustomTitleBar QLabel#OperationStatusTitle[tone='error'] { color: #b74450; }
QWidget#CustomTitleBar QPushButton#StopButton { min-height: 0; padding: 0 12px; border-radius: 16px; }
QFrame#OperationStatusPanel[motionHeader='true'] QToolButton { color: #737e91; font-size: 12px; padding: 1px 4px; }
QFrame#OperationStatusPanel[motionHeader='true'][tone='warning'] QLabel#OperationStatusTitle { color: #987027; }
QFrame#OperationStatusPanel[motionHeader='true'][tone='success'] QLabel#OperationStatusTitle { color: #4a806d; }
QFrame#OperationStatusPanel[motionHeader='true'][tone='error'] QLabel#OperationStatusTitle { color: #b74450; }
QStatusBar { background: #ffffff; color: #737e91; border-top: 1px solid #dce0e9; font-size: 11px; }
