# The two projects must receive the same explicit group and UTC timestamp.
# Identity covers their shared production-input union, independent of Git HEAD.
include_guard(GLOBAL)

set(FW_RELEASE_ID "2026101001" CACHE STRING "Firmware release as YYYYMMDDrr")
set(FW_BUILDSET "" CACHE STRING "Shared firmware build group: exactly 16 hex digits")
set(FW_BUILD_EPOCH "" CACHE STRING "Shared firmware build time: UTC Unix seconds")

function(firmware_configure_identity)
    cmake_parse_arguments(IDENTITY "" "" "TARGETS" ${ARGN})
    if(NOT IDENTITY_TARGETS OR IDENTITY_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "firmware_configure_identity requires TARGETS")
    endif()
    foreach(_name FW_RELEASE_ID FW_BUILD_EPOCH)
        if(NOT "${${_name}}" MATCHES "^(0|[1-9][0-9]*)$")
            message(FATAL_ERROR "${_name} must be an explicit unsigned decimal integer")
        endif()
        string(LENGTH "${${_name}}" _length)
        if(_length GREATER 10 OR "${${_name}}" GREATER 4294967295)
            message(FATAL_ERROR "${_name} must fit uint32_t")
        endif()
    endforeach()
    string(LENGTH "${FW_BUILDSET}" _group_length)
    if(NOT _group_length EQUAL 16 OR NOT FW_BUILDSET MATCHES "^[0-9A-Fa-f]+$")
        message(FATAL_ERROR "Pass the same explicit -DFW_BUILDSET=<16 hex digits> to both firmware projects")
    endif()
    string(TOUPPER "${FW_BUILDSET}" _group)

    get_filename_component(_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    set(_core "${_root}/dummy-ref-core-fw")
    set(_motor "${_root}/dummy-motor-fw")
    set(_patterns)
    foreach(_dir startup Drivers Core UserApp 3rdParty Middlewares USB_DEVICE Robot Bsp)
        list(APPEND _patterns "${_core}/${_dir}/*.*")
    endforeach()
    foreach(_dir startup Drivers Core Ctrl UserApp Port)
        list(APPEND _patterns "${_motor}/${_dir}/*.*")
    endforeach()
    file(GLOB_RECURSE _inputs LIST_DIRECTORIES false CONFIGURE_DEPENDS ${_patterns})
    list(APPEND _inputs
            "${_core}/CMakeLists.txt"
            "${_motor}/CMakeLists.txt"
            "${_core}/STM32F405RGTx_FLASH.ld"
            "${_motor}/STM32F103CBTx_FLASH.ld"
            "${_core}/Drivers/CMSIS/Lib/libarm_cortexM4lf_math.a"
            "${_root}/stop_protocol.h"
            "${_root}/protection_protocol.h"
            "${_root}/motion_completion_protocol.h"
            "${CMAKE_CURRENT_FUNCTION_LIST_FILE}")
    list(REMOVE_DUPLICATES _inputs)
    list(SORT _inputs)
    # Reconfigure on content changes too: compiler depfiles alone cannot refresh
    # an identity computed when CMake last ran. CONFIGURE_DEPENDS covers add/remove.
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_inputs})
    set(_input_manifest "")
    foreach(_input IN LISTS _inputs)
        if(NOT EXISTS "${_input}" OR IS_DIRECTORY "${_input}")
            message(FATAL_ERROR "Missing firmware identity input: ${_input}")
        endif()
        file(RELATIVE_PATH _relative "${_root}" "${_input}")
        file(SHA256 "${_input}" _digest)
        string(APPEND _input_manifest "${_relative}\t${_digest}\n")
    endforeach()
    string(SHA256 _source_hash "${_input_manifest}")

    set(_generated "${CMAKE_BINARY_DIR}/generated")
    file(MAKE_DIRECTORY "${_generated}")
    # Keep history in this build directory, including groups used before a newer
    # group. A reused group may never silently identify changed production bytes.
    set(_registry "${_generated}/fw_buildsets.txt")
    set(_record "${_group}|${FW_RELEASE_ID}|${FW_BUILD_EPOCH}|${_source_hash}")
    set(_known false)
    if(EXISTS "${_registry}")
        file(STRINGS "${_registry}" _records)
        foreach(_previous IN LISTS _records)
            if(_previous MATCHES "^${_group}\\|")
                if(NOT _previous STREQUAL _record)
                    message(FATAL_ERROR
                            "FW_BUILDSET ${_group} was already registered with different source/release/time. "
                            "Choose a fresh group and pass one shared UTC epoch to both projects.")
                endif()
                set(_known true)
            endif()
        endforeach()
    endif()

    string(SUBSTRING "${_group}" 0 8 _group_high)
    string(SUBSTRING "${_group}" 8 8 _group_low)
    set(_hash_words "")
    foreach(_index RANGE 0 7)
        math(EXPR _offset "${_index} * 8")
        string(SUBSTRING "${_source_hash}" ${_offset} 8 _word)
        string(APPEND _hash_words "    0x${_word}u,\n")
    endforeach()
    set(_header "#pragma once\n#include <stdint.h>\n\n#ifndef FW_TARGET_TYPE\n#error FW_TARGET_TYPE must identify this firmware target\n#endif\nstatic_assert(FW_TARGET_TYPE == 0 || FW_TARGET_TYPE == 35 || FW_TARGET_TYPE == 42 || FW_TARGET_TYPE == 57 || FW_TARGET_TYPE == 8, \"Unsupported firmware target type\");\n\nnamespace FWIdentity {\ninline constexpr uint32_t WORDS[14] = {\n    0x31565746u,\n    0x00000701u | (uint32_t(FW_TARGET_TYPE) << 16),\n    ${FW_RELEASE_ID}u,\n    ${FW_BUILD_EPOCH}u,\n    0x${_group_high}u,\n    0x${_group_low}u,\n${_hash_words}};\n}\n")
    file(CONFIGURE OUTPUT "${_generated}/fw_build_identity.h" CONTENT "${_header}" @ONLY NEWLINE_STYLE LF)
    set(FW_SOURCE_SHA256 "${_source_hash}" CACHE INTERNAL "Shared production input SHA256" FORCE)
    set(FW_SOURCE_SHA256 "${_source_hash}" PARENT_SCOPE)

    # Toolchain/options belong to each artifact's manifest, rather than changing
    # the common production-source hash shared by F405 and all four F103 targets.
    set(_manifest "schema=1\nrelease=${FW_RELEASE_ID}\nbuildset=${_group}\nutc_epoch=${FW_BUILD_EPOCH}\nsource_sha256=${_source_hash}\nproject=${PROJECT_NAME}\ngenerator=${CMAKE_GENERATOR}\ncmake=${CMAKE_VERSION}\nbuild_type=${CMAKE_BUILD_TYPE}\n")
    string(TOUPPER "${CMAKE_BUILD_TYPE}" _configuration)
    foreach(_language C CXX ASM)
        foreach(_suffix COMPILER COMPILER_ID COMPILER_VERSION COMPILER_TARGET COMPILER_ARG1 COMPILER_LAUNCHER FLAGS)
            string(APPEND _manifest "${_language}_${_suffix}=${CMAKE_${_language}_${_suffix}}\n")
        endforeach()
        string(APPEND _manifest "${_language}_FLAGS_${_configuration}=${CMAKE_${_language}_FLAGS_${_configuration}}\n")
    endforeach()
    foreach(_tool CMAKE_C_COMPILER CMAKE_CXX_COMPILER CMAKE_ASM_COMPILER CMAKE_AR CMAKE_LINKER CMAKE_OBJCOPY)
        set(_tool_path "${${_tool}}")
        if(_tool_path AND NOT IS_ABSOLUTE "${_tool_path}")
            find_program(_identity_tool_path NAMES "${_tool_path}")
            if(_identity_tool_path)
                set(_tool_path "${_identity_tool_path}")
            endif()
            unset(_identity_tool_path CACHE)
            unset(_identity_tool_path)
        endif()
        string(APPEND _manifest "tool.${_tool}.path=${_tool_path}\n")
        if(EXISTS "${_tool_path}" AND NOT IS_DIRECTORY "${_tool_path}")
            file(SHA256 "${_tool_path}" _tool_hash)
            string(APPEND _manifest "tool.${_tool}.sha256=${_tool_hash}\n")
        endif()
    endforeach()
    string(APPEND _manifest "C_STANDARD=${CMAKE_C_STANDARD}\nCXX_STANDARD=${CMAKE_CXX_STANDARD}\nSYSROOT=${CMAKE_SYSROOT}\n")
    string(APPEND _manifest "EXE_LINKER_FLAGS=${CMAKE_EXE_LINKER_FLAGS}\nEXE_LINKER_FLAGS_${_configuration}=${CMAKE_EXE_LINKER_FLAGS_${_configuration}}\nCOMMON_FLAGS=${COMMON_FLAGS}\n")
    if(CMAKE_TOOLCHAIN_FILE)
        get_filename_component(_toolchain "${CMAKE_TOOLCHAIN_FILE}" ABSOLUTE BASE_DIR "${CMAKE_BINARY_DIR}")
        if(EXISTS "${_toolchain}")
            file(SHA256 "${_toolchain}" _toolchain_hash)
            string(APPEND _manifest "toolchain_file=${_toolchain}\ntoolchain_sha256=${_toolchain_hash}\n")
        endif()
    endif()
    foreach(_property COMPILE_DEFINITIONS COMPILE_OPTIONS INCLUDE_DIRECTORIES LINK_OPTIONS LINK_DIRECTORIES LINK_LIBRARIES)
        get_directory_property(_value "${_property}")
        string(APPEND _manifest "directory.${_property}=${_value}\n")
    endforeach()
    foreach(_target IN LISTS IDENTITY_TARGETS)
        if(NOT TARGET "${_target}")
            message(FATAL_ERROR "Unknown firmware identity target: ${_target}")
        endif()
        target_include_directories("${_target}" PRIVATE "${_generated}")
        foreach(_property COMPILE_DEFINITIONS COMPILE_OPTIONS INCLUDE_DIRECTORIES LINK_OPTIONS LINK_LIBRARIES LINK_DEPENDS)
            get_target_property(_value "${_target}" "${_property}")
            if(_value STREQUAL "_value-NOTFOUND")
                set(_value "")
            endif()
            string(APPEND _manifest "target.${_target}.${_property}=${_value}\n")
        endforeach()
    endforeach()
    foreach(_source IN LISTS SOURCES)
        get_source_file_property(_options "${_source}" COMPILE_OPTIONS)
        if(_options AND NOT _options STREQUAL "NOTFOUND")
            file(RELATIVE_PATH _relative "${_root}" "${_source}")
            string(APPEND _manifest "source.${_relative}.COMPILE_OPTIONS=${_options}\n")
        endif()
    endforeach()
    # The group is common across projects, but its environment is fixed locally:
    # F405 and F103 may have different tools/options, while neither build directory
    # may reuse an old group for changed compiler bytes, flags, or output paths.
    string(SHA256 _environment_hash "${_manifest}\n[input_sha256]\n${_input_manifest}")
    set(_environment_registry "${_generated}/fw_buildset_environments.txt")
    set(_environment_record "${_group}|${_environment_hash}")
    set(_environment_known false)
    if(EXISTS "${_environment_registry}")
        file(STRINGS "${_environment_registry}" _environment_records)
        foreach(_previous IN LISTS _environment_records)
            if(_previous MATCHES "^${_group}\\|")
                if(NOT _previous STREQUAL _environment_record)
                    message(FATAL_ERROR
                            "FW_BUILDSET ${_group} was already registered with a different local "
                            "compiler/tool binary, options, link input, or generation path. Choose a fresh group.")
                endif()
                set(_environment_known true)
            endif()
        endforeach()
    endif()
    string(APPEND _manifest "environment_sha256=${_environment_hash}\n\n[input_sha256]\n${_input_manifest}")
    file(CONFIGURE OUTPUT "${_generated}/fw_build_manifest.txt" CONTENT "${_manifest}" @ONLY NEWLINE_STYLE LF)
    if(NOT _known)
        file(APPEND "${_registry}" "${_record}\n")
    endif()
    if(NOT _environment_known)
        file(APPEND "${_environment_registry}" "${_environment_record}\n")
    endif()
    message(STATUS "Firmware identity: release=${FW_RELEASE_ID}, group=${_group}, source=${_source_hash}")
endfunction()
